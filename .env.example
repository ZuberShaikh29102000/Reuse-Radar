# Copy to .env and fill in. Never commit .env.

# Contact address sent in the User-Agent to INSPIRE (required by SPEC section 2, item 5).
INSPIRE_CONTACT_EMAIL=you@example.org

# Where HTTP response caches live. Defaults to ./.cache
REUSE_RADAR_CACHE_DIR=.cache

# Where pipeline outputs (JSONL) are written. Defaults to ./data
REUSE_RADAR_DATA_DIR=data
