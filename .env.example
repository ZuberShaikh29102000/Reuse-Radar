# Copy to .env and fill in. Never commit .env.
# Real environment variables take precedence over this file (that is how CI injects secrets),
# so a stale system-level variable will shadow the value here.

# Contact address sent in the User-Agent to INSPIRE and arXiv (SPEC section 2, item 5).
INSPIRE_CONTACT_EMAIL=you@example.org

# Where HTTP and LLM response caches live. Defaults to ./.cache
REUSE_RADAR_CACHE_DIR=.cache

# Where pipeline outputs (JSONL/JSON) are written. Defaults to ./data
REUSE_RADAR_DATA_DIR=data

# LLM providers (free tiers). Groq is primary, Gemini is the fallback.
# Groq: console.groq.com -> API Keys.  Gemini: aistudio.google.com -> Get API key.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional model overrides (defaults shown).
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash   (fallback chain, in order)

# Django / Postgres (Phase 4+). Local: `docker compose up -d db` matches this URL.
DATABASE_URL=postgres://reuse_radar:local-dev-only@127.0.0.1:5432/reuse_radar
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# DJANGO_DEBUG=1
# DJANGO_ALLOWED_HOSTS=localhost
# Frontend origin(s) allowed to call the API (Phase 6), comma-separated.
# CORS_ALLOWED_ORIGINS=https://reuse-radar.pages.dev
# API_RATE_LIMIT=120/min
# Curators who may accept/reject products through the API (name:token, comma-separated).
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# REVIEWER_TOKENS=alice:<token>
