    "descriptions": [
     {
      "descriptionType": "Abstract",
      "description": "This HEPData entry contains the results from the ATLAS Run 2 inclusive and differential cross-section measurements, \nincluding inclusive fits and differential fits for multiple observables.\n\nThe submission contains bootstrap replicas and HS3 JSON files for likelihood fits in each region and \nworkspace files for nominal and unregularized differential fits. The complete set of HS3 JSON files\ncan be found at https://zenodo.org/records/14538237."
     }
